# Ledgerline — environment variables
# Copy to .env for local development (`.env` is git-ignored). In Vercel, set
# these under Project → Settings → Environment Variables. Never commit real
# values. The server validates the combination at start-up and refuses to run
# with an unsafe one.

# ── General ──────────────────────────────────────────────────────────────────
NODE_ENV=development                 # development | test | production
APP_MODE=demo                        # demo | live (live = real money; see docs/DEPLOYMENT.md §9)
APP_NAME=Ledgerline
APP_URL=http://localhost:3000        # production: https://your-domain.com (exactly what users type)
ALLOWED_ORIGINS=                     # extra origins, comma-separated (normally empty)
PORT=3000                            # local server only
LOG_LEVEL=info                       # debug | info | warn | error

# ── Database (Supabase PostgreSQL) ───────────────────────────────────────────
# Local PostgreSQL (or `supabase start`). On Vercel use the Supabase transaction pooler, port 6543:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/ledgerline
# Migrations (npm run db:migrate): session pooler (5432) or direct connection.
MIGRATION_DATABASE_URL=
# Long-lived connection for the SSE fallback (LISTEN). Not needed with Supabase Realtime.
DATABASE_URL_DIRECT=
DB_POOL_MAX=5
DB_PREPARE=false                     # keep false behind the transaction pooler

# ── Authentication ───────────────────────────────────────────────────────────
AUTH_PROVIDER=local                  # supabase (production) | local (development and tests only)
SUPABASE_URL=                        # https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=            # sb_publishable_…
SUPABASE_SECRET_KEY=                 # optional, server-only; not required by this app
SUPABASE_JWT_SECRET=                 # only for projects still on the legacy HS256 JWT secret
LOCAL_JWT_SECRET=change-me-to-32-or-more-random-characters   # AUTH_PROVIDER=local only

# ── Cookies, proxies, privacy ────────────────────────────────────────────────
COOKIE_SECURE=                       # empty = automatic (on for https); cannot be off in production
COOKIE_DOMAIN=                       # empty = host-only __Host- cookies (recommended)
TRUST_PROXY=1                        # Vercel: 1
IP_HASH_SECRET=                      # 32+ random characters (openssl rand -hex 32); required in production

# ── Email (the app's own messages; Supabase Auth sends its own via custom SMTP) ──
EMAIL_PROVIDER=log                   # log (writes messages, incl. links and codes, to the server log; dev/demo only) | resend | postmark
EMAIL_FROM=Ledgerline <no-reply@example.com>   # production: your verified sender
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=

# ── Blockchain events ────────────────────────────────────────────────────────
BLOCKCHAIN_WEBHOOK_SECRET=           # 32+ random characters; signs /webhooks/blockchain/generic
ALCHEMY_WEBHOOK_SIGNING_KEYS=        # comma-separated signing keys of your Alchemy webhooks
ALCHEMY_NETWORK_MAP={"ETH_MAINNET":"ETHEREUM"}
CHAIN_RPC_URLS={}                    # e.g. {"ETHEREUM":"https://eth-mainnet.g.alchemy.com/v2/<key>","TRON":"https://api.trongrid.io","BITCOIN":"https://mempool.space/api"}

# ── Compliance ───────────────────────────────────────────────────────────────
KYC_PROVIDER=manual                  # manual | sumsub (required for live)
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=
SUMSUB_LEVEL_NAME=basic-kyc-level
SUMSUB_BASE_URL=https://api.sumsub.com
SCREENING_PROVIDER=none              # none | http (required for live)
SCREENING_API_URL=
SCREENING_API_KEY=
LEGAL_APPROVAL_CONFIRMED=false       # set true only after licensing and legal review

# ── Prices ───────────────────────────────────────────────────────────────────
PRICE_PROVIDER=static                # static | coingecko (required for live)
PRICE_STATIC={"USDT":"1","USDC":"1","BTC":"60000","ETH":"3000"}   # demo only; illustrative values
COINGECKO_API_KEY=

# ── Jobs, live updates, limits ───────────────────────────────────────────────
CRON_SECRET=                         # 32+ random characters; Vercel Cron sends it automatically; same value in Supabase Vault for pg_cron
CRON_PLAN=                           # only for `npm run vercel:config`: pro = Vercel Cron every 5 min (Pro plan); empty = Hobby schedule
LIVE_TRANSPORT=                      # empty = automatic (supabase when configured, otherwise sse)
LIVE_SSE_MAX_SECONDS=240
RATE_LIMIT_STORE=                    # empty = automatic (postgres in production, memory locally)

# ── Monitoring ───────────────────────────────────────────────────────────────
ERROR_WEBHOOK_URL=                   # optional Slack/Teams incoming webhook

# ── Demo ─────────────────────────────────────────────────────────────────────
DEMO_TOOLS_ENABLED=false             # true only in demo deployments (simulate deposits etc.)
STAFF_MFA_REQUIRED=                  # empty = false: 2FA is optional for staff; true makes it mandatory in production

# ── Tests ────────────────────────────────────────────────────────────────────
TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
PLAYWRIGHT_CHROMIUM_PATH=
