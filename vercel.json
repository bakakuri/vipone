{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/migrate.js && node scripts/seed-demo.js && npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": false,
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "public/locales/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/",
      "destination": "/pages/home.html"
